# Copy to .env on the VPS. Fill secrets privately; never commit .env.
# NEXT_PUBLIC_* values are Docker BUILD inputs; rebuild when they change.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=https://asra3.com
NEXT_PUBLIC_BRAND_NAME=Asra3
NEXT_PUBLIC_BRAND_PRIMARY_COLOR=#4F46E5
NEXT_PUBLIC_BRAND_LOGO_URL=https://asra3.com/logo.png

# Server-only. Generate distinct random secrets with at least32bytes of entropy.
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ZERNIO_API_KEY=
ZERNIO_BASE_URL=https://zernio.com/api/v1
# Actual provider webhook signing secret; do not invent a replacement.
ZERNIO_WEBHOOK_SECRET=
# Shared private bearer token for BOTH drains,32+characters.
WEBHOOK_DRAIN_SECRET=
# Compose overrides for shared worker; manual --once can dispatch due jobs.
WEBHOOK_DRAIN_URL=http://127.0.0.1:3008/api/internal/webhooks/drain
# Host loopback mapping. Container internal port stays3008.
PORT=3008

# Customer passwords/email confirmation/recovery use Supabase Auth.
# Configure Supabase Site URL, redirect allowlist and SMTP outside this file.
# Durable CRM/security/spending/jobs require full SQL pack and service key.
# Missing database configuration fails closed; .data is NOT a DB fallback.
# Customer payment collection and AI/workflow automation remain Coming soon.
