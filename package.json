{
  "name": "zernio-saas-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5651",
    "build": "next build",
    "start": "next start -p 5651",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test:phase1a": "node --test scripts/tests/phase1a-*.test.mjs",
    "test:phase1b": "node --test scripts/tests/phase1b-*.test.mjs",
    "test:phase1c": "node --test scripts/tests/phase1c-*.test.mjs",
    "test:phase1c:database": "node scripts/tests/phase1c-postgres-check.mjs",
    "test:phase1d": "node --test scripts/tests/phase1d-*.test.mjs",
    "test:phase2a": "node --test scripts/tests/phase2a-*.test.mjs",
    "test:phase2b": "node --test scripts/tests/phase2b-*.test.mjs",
    "test:phase2c": "node --test scripts/tests/phase2c-*.test.mjs",
    "test:phase3a": "node --test scripts/tests/phase3a-*.test.mjs",
    "test:launch": "node --test --test-concurrency=2 scripts/tests/launch-*.test.mjs",
    "test:launch:database": "node scripts/tests/launch-database-suite.mjs",
    "test:billing": "node --test scripts/tests/prepaid-*.test.mjs scripts/tests/billing-enrollment.test.mjs scripts/tests/phone-sms-segments.test.mjs",
    "test:billing:database": "node scripts/tests/customer-wallet-postgres-check.mjs && node scripts/tests/customer-billing-service-check.mjs",
    "test:regression": "node --test --test-concurrency=2 scripts/tests/phase*.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@zernio/node": "^0.2.1214",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "p-limit": "^7.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
